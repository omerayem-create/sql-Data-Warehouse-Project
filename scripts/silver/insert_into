-- loading into silver.crm_cust_info table
--------------------------------------------------------------------------
Truncate table silver.crm_sales_details;
GO

insert into silver.crm_cust_info
(
cst_id,
cst_key,
cst_firstname,
cst_lastname,
cst_marital_status,
cst_gndr,
cst_create_date


)

SELECT 
cst_id,
cst_key,
trim(cst_firstname) as cst_firstname,    -- removing spaces
trim(cst_lastname) as cst_lastname,
case when upper(trim(cst_marital_status)) = 'S' then 'Single'    -- clearing abrevation 
     when upper(trim(cst_marital_status)) = 'M' then 'Married'
     
     end  cst_marital_status,
case when upper(trim(cst_gndr)) = 'M' then 'Male'       
     when upper(trim(cst_gndr)) = 'F' then 'Female'
     
     end cst_gndr ,
cst_create_date

FROM
-- subquery for removing duplicate or nulls from cst_id
(select *,                                               
ROW_NUMBER() OVER (PARTITION BY CST_ID ORDER BY cst_create_date DESC) ROWNUMBER   
from bronze.crm_cust_info

WHERE cst_id is not null)t
where ROWNUMBER = 1;
