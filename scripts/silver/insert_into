  replace( cid , '-' ,'') cid,
  case
     when trim(cntry) = '' then null            -- nullig empty spaces and changes abreviations to fullname
	 when cntry = upper(trim('DE')) or cntry = upper(trim('Germany')) then 'Germany'
	 when cntry = upper(trim('USA')) or cntry = upper(trim('US')) or cntry =  upper(trim('United States')) then 'United States'
	 else cntry end cntry




from bronze.erp_loc_a101 ;

