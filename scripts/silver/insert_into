-- loading into silver.crm_cust_info table
--------------------------------------------------------------------------
insert into silver.crm_cust_info
(
cst_id,
cst_key,
cst_firstname,
cst_lastname,
cst_marital_status,
cst_gndr,
cst_create_date


)

SELECT 
cst_id,
cst_key,
trim(cst_firstname) as cst_firstname,    -- removing spaces
trim(cst_lastname) as cst_lastname,
case when upper(trim(cst_marital_status)) = 'S' then 'Single'    -- clearing abrevation 
     when upper(trim(cst_marital_status)) = 'M' then 'Married'
     
     end  cst_marital_status,
case when upper(trim(cst_gndr)) = 'M' then 'Male'       
     when upper(trim(cst_gndr)) = 'F' then 'Female'
     
     end cst_gndr ,
cst_create_date

FROM
-- subquery for removing duplicate or nulls from cst_id
(select *,                                               
ROW_NUMBER() OVER (PARTITION BY CST_ID ORDER BY cst_create_date DESC) ROWNUMBER   
from bronze.crm_cust_info

WHERE cst_id is not null)t
where ROWNUMBER = 1
------------------------------------------------------------------------------

--Loading clean data into silver>crm_prd_info table 
------------------------------------------------------------------------------
insert into silver.crm_prd_info
(
    prd_id ,
	cat_id,
	prd_key ,
	prd_nm ,
	prd_cost ,
	prd_line ,
	prd_start_dt ,
    prd_end_dt 

)


select 
prd_id,
replace(SUBSTRING(prd_key,1,5), '-', '_') cat_id,  -- extracting cat_id and prd_key
SUBSTRING(prd_key,7,len(prd_key)) as  prd_key,
prd_nm,
isnull(prd_cost,0) prd_cost,              -- replacing nulls
case upper(trim(prd_line))                
    when 'M' THEN 'Mountain'
    when 'R' THEN 'Road'
    when 'S' THEN 'Other sales'
    when 'T' THEN 'Touring'
    else 'n/a'
end prd_line,
prd_start_dt,
lead(prd_start_dt)over(partition by prd_key order by prd_start_dt) prd_end_dt    -- correcting wrong end_date  
from bronze.crm_prd_info
------------------------------------------------------------------------------

--Loading clean data from bronze.crm_sales_datails
--==============================================================================

insert into  silver.crm_sales_details (

  sls_ord_num  ,
   sls_prd_key ,
   sls_cust_id  ,
   sls_order_dt ,
   sls_ship_dt ,
   sls_due_dt ,
   sls_sales ,
   sls_quantity ,
   sls_price 
)

select   
       sls_ord_num  ,
       sls_prd_key ,
       sls_cust_id  ,
        case when sls_order_dt = 0 or len(sls_order_dt) != 8 then null    -- handling nulls and casting into date 
         else 
         cast(cast(sls_order_dt as nvarchar ) as date) end  sls_order_dt , 
  
      case when  sls_ship_dt = 0 or len( sls_ship_dt) != 8 then null     -- handling nulls and casting into date
       else 
         cast(cast( sls_ship_dt as nvarchar ) as date) end   sls_ship_dt ,
  
      case when  sls_due_dt = 0 or len( sls_due_dt) != 8 then null        -- handling nulls and casting into date
        else 
         cast(cast( sls_due_dt as nvarchar ) as date) end   sls_due_dt ,
    
        case when sls_sales < sls_quantity*sls_price
                or sls_sales <=0                                         -- handling negative and null prices 
                or sls_sales is null then sls_quantity*sls_price
                else sls_sales       end sls_sales ,
       sls_quantity ,
       case when  sls_price <= 0                                           -- handling negative and null prices
                 or sls_price is null then  sls_sales/ abs(sls_quantity) 
                 else sls_price      end sls_price 

from bronze.crm_sales_details
  
