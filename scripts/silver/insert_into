-- Loading clean data from bronze.erp_cust_az12 into silver.erp_cust_az12 table 
--===========================================================================================================
Truncate table ;
GO
insert into silver.erp_cust_az12
( 
cid,
bdate,
gen


)


select 
	 case when  cid like 'nas%' then SUBSTRING(cid,4,len(cid))
	 else cid end  cid ,
	  case when bdate > getdate() 
     OR  bdate < DATEADD(year, -100, GETDATE())  then null
     else bdate end bdate,
	 case when gen = upper(trim('F')) or gen = upper(trim('Female')) then 'Female'  
     when gen = upper(trim('M')) or gen = upper(trim('Male')) then 'Male'
     else 'n/a' end gen

from bronze.erp_cust_az12 ;
