--Loading clean data from bronze.crm_sales_datails in silver.crm_sales_details
--==============================================================================
Truncate table silver.crm_sales_details;
GO

insert into  silver.crm_sales_details (

  sls_ord_num  ,
   sls_prd_key ,
   sls_cust_id  ,
   sls_order_dt ,
   sls_ship_dt ,
   sls_due_dt ,
   sls_sales ,
   sls_quantity ,
   sls_price 
)

select   
       sls_ord_num  ,
       sls_prd_key ,
       sls_cust_id  ,
        case when sls_order_dt = 0 or len(sls_order_dt) != 8 then null    -- handling nulls and casting into date 
         else 
         cast(cast(sls_order_dt as nvarchar ) as date) end  sls_order_dt , 
  
      case when  sls_ship_dt = 0 or len( sls_ship_dt) != 8 then null     -- handling nulls and casting into date
       else 
         cast(cast( sls_ship_dt as nvarchar ) as date) end   sls_ship_dt ,
  
      case when  sls_due_dt = 0 or len( sls_due_dt) != 8 then null        -- handling nulls and casting into date
        else 
         cast(cast( sls_due_dt as nvarchar ) as date) end   sls_due_dt ,
    
        case when sls_sales != sls_quantity*abs(sls_price) then sls_quantity*abs(sls_price)
                when sls_sales <=0   then sls_quantity*abs(sls_price)                                      -- handling negative and null prices 
                when sls_sales is null then sls_quantity*abs(sls_price)
                else sls_sales       end sls_sales ,
       sls_quantity ,
       case 
             when sls_price <= 0                                          -- handling negative and null prices
              or sls_price is null then  abs(sls_sales)/ abs(sls_quantity) 
               else sls_price      end sls_price 

from bronze.crm_sales_details;

